{
  "name": "n8n-nodes-gscmagic",
  "version": "0.1.2",
  "description": "n8n community node for GSC Magic: Google Search Console reports, traffic drops, quick wins and URL inspection",
  "license": "MIT",
  "homepage": "https://gscmagic.com",
  "keywords": [
    "n8n-community-node-package",
    "gscmagic",
    "google-search-console",
    "seo",
    "mcp",
    "automation"
  ],
  "author": {
    "name": "Lumi Zone Łukasz Blania",
    "email": "contact@gscmagic.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumizone/n8n-nodes-gscmagic.git"
  },
  "bugs": {
    "url": "https://github.com/lumizone/n8n-nodes-gscmagic/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run lint:scan",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "lint:scan": "node scripts/scan-lint.mjs"
  },
  "files": [
    "dist",
    "examples",
    "CHANGELOG.md"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/GscMagicApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GscMagic/GscMagic.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.55.5",
    "eslint": "9.29.0",
    "prettier": "3.6.2",
    "release-it": "20.2.0",
    "tsx": "^4.23.15",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "publishConfig": {
    "access": "public"
  }
}
